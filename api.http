@baseUrl = http://127.0.0.1:8000

### Health check
GET {{baseUrl}}/heartbeat

### Ask - no category (question only)
POST {{baseUrl}}/ask
Content-Type: application/json

{
  "question": "What is FastAPI?"
}

### Ask - no category, door question
POST {{baseUrl}}/ask
Content-Type: application/json

{
  "question": "How to add a door in Revit?"
}

### Ask - no category, floor question
POST {{baseUrl}}/ask
Content-Type: application/json

{
  "question": "How to add a floor in Revit?"
}

### Ask - missing required field (expect 422)
POST {{baseUrl}}/ask
Content-Type: application/json

{
}

### Ask - with category
POST {{baseUrl}}/ask
Content-Type: application/json

{
  "question": "How to add a floor in Revit?",
  "category": "floors"
}
